# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# Chuỗi kết nối PostgreSQL
DATABASE_URL=postgres://fanpage:DOI_MAT_KHAU@localhost:5432/fanpage_manager

# Địa chỉ công khai của ứng dụng (dùng https:// khi triển khai lên VPS để cookie được bật Secure)
BASE_URL=http://localhost:5173

# Khóa mã hóa token Facebook (AES-256, 32 byte mã hóa base64). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mất khóa này thì mọi token đã lưu không giải mã được (phải kết nối lại Facebook).
TOKEN_ENCRYPTION_KEY=

# Meta App (lấy ở App Dashboard > Cài đặt ứng dụng > Cơ bản). Bỏ dấu # và điền để bật kết nối Facebook.
# FB_APP_ID=
# FB_APP_SECRET=
# Phiên bản Graph API (mặc định v26.0)
# FB_GRAPH_VERSION=v26.0
# Chỉ điền nếu ứng dụng loại Business dùng Facebook Login for Business (ID của "Configuration")
# FB_LOGIN_CONFIG_ID=
